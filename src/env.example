# ============================================================
# MODE SELECTION
# ============================================================
# "copy"     -> original copy-trading / target-wallet sniper (requires COPY_TRADING_TARGET_ADDRESS)
# "momentum" -> pump.fun momentum sniper: buys strength not age, no copy-trading
MONITORING_MODE=momentum

# Momentum data feed: "grpc" (Yellowstone, fastest, needs a gRPC endpoint) or
# "ws" (standard RPC websocket blockSubscribe — works on Chainstack/Helius wss
# WITHOUT gRPC or a Business plan). For "ws", set RPC_WSS below.
MOMENTUM_FEED=grpc
RPC_WSS=wss://your-websocket-endpoint   # used only when MOMENTUM_FEED=ws

# ============================================================
# MOMENTUM SNIPER (used when MONITORING_MODE=momentum)
# Buys statistically significant momentum regardless of token age/lifecycle.
# ============================================================
# DRY RUN: paper-trade with no transactions sent. Runs the full strategy on the
# live stream, simulates fills at market cap minus SIM_COST_FRACTION, and logs to
# the trade CSV. Validate the edge here before going live. Set to false for real money.
MOMENTUM_DRY_RUN=true
MOMENTUM_SIM_COST_FRACTION=0.03      # simulated round-trip cost per fill (0.03 = 3%: fees+tip+slippage)

MOMENTUM_POSITION_SIZE_SOL=0.2       # fixed SOL per trade (used when POSITION_SIZE_PCT=0)
MOMENTUM_POSITION_SIZE_PCT=0         # >0 = size as a FRACTION of equity (bankroll mode); scales up as you
                                     # win, down as you lose. e.g. 0.05 = 5% of equity per position
MOMENTUM_MAX_POSITIONS=5             # max concurrent positions
MOMENTUM_ENTRY_SCORE=57              # 0..100 continuation-probability score required to buy
                                     # (tuned: dry-run winners avg ~58, losers ~54 — sits between them)
MOMENTUM_MIN_BASE_SCORE=0            # min BASE momentum score before boosts (0=off). Stops KOL/alpha
                                     # boosts dragging in weak tokens. Try 50 to lift win rate.
MOMENTUM_STAGNATION_SECS=0           # cut a position that never reaches MIN_PNL within this many secs
                                     # (0=off). Kills dead tokens before they bleed into a hard stop.
MOMENTUM_STAGNATION_MIN_PNL=20       # the "never got going" threshold for the stagnation stop (% PnL)
MOMENTUM_COLLAPSE_SCORE=35           # below this score, cut the position (failed momentum)
MOMENTUM_HARD_STOP_PCT=-35           # hard stop loss (% from entry market cap)
MOMENTUM_SHORT_WINDOW_SECS=30        # "now" window for momentum
MOMENTUM_MEDIUM_WINDOW_SECS=120      # baseline window for acceleration
MOMENTUM_MIN_BUY_VOLUME_SOL=2.0      # short-window buy volume that scores full marks
MOMENTUM_TARGET_UNIQUE_BUYERS=10     # short-window unique buyers that scores full marks
MOMENTUM_TARGET_MCAP_GROWTH=0.30     # short-window mcap growth that scores full marks (0.30 = 30%)
MOMENTUM_MAX_WALLET_CONCENTRATION=0.50  # max single-wallet share of buy volume before penalty
# Anti-fake / manufactured-momentum hardening:
MOMENTUM_MIN_BUYER_DIVERSITY=0.35    # min (unique buyers / buy txns); below this volume looks spammed
MOMENTUM_MAX_WASH_FRACTION=0.40      # max share of buy volume from wallets that also sold (wash trading)
MOMENTUM_MAX_CREATOR_BUY_FRAC=0.15   # max share of buy volume from the CREATOR's own wallet before the
                                     #   score is cut — kills fake pumps from creator/bundler self-buying (0=off)
# ---- Structure gate: every entry must have REAL structure, not just a momentum number ----
# The vetoes above reject BAD structure; this REQUIRES good structure (genuine, broad demand).
# It's what stops the bot buying coin-flips. Tighten for fewer/higher-quality entries; if
# entries dry up too much, loosen these or set MOMENTUM_REQUIRE_STRUCTURE=false.
# ---- Co-buy clustering: detect coordinated wallet groups (cabals) from the feed ----
# Wallets that keep buying the SAME tokens get linked into a shared cluster_id (visible in
# wallet_scores.py --csv). No funding data / indexer needed — pure co-occurrence.
MOMENTUM_CLUSTER_ENABLED=true         # build wallet clusters from shared token buys
MOMENTUM_CLUSTER_MIN_SHARED=3         # distinct tokens a wallet PAIR must co-buy before linking
# Avoid bundler/dumper clusters: veto a buy when a coordinated group with a bad track
# record is driving the pump (fails safe until clusters have enough graded history).
MOMENTUM_CLUSTER_MIN_SAMPLES=8        # combined graded trades before a cluster is judged
MOMENTUM_CLUSTER_BAD_ROI=-0.20        # cluster is a dumper if combined avg ROI <= this
MOMENTUM_CLUSTER_BAD_RUG_RATE=0.40    # ...or if this share of its buys ended in rugs
MOMENTUM_CLUSTER_VETO_SHARE=0.30      # veto when a dumper cluster drives >= this share of recent buys
MOMENTUM_REQUIRE_STRUCTURE=true      # master switch for the structure gate
MOMENTUM_STRUCT_MIN_GENUINE=0.55     # min genuine-demand factor (0..1); filters manufactured/washed pumps
MOMENTUM_STRUCT_MIN_BUYERS=4         # min DISTINCT real buyers in the short window (a real move has a crowd)
# min bonding-curve liquidity (SOL) for an entry. Default 1.5 is DATA-DERIVED from our
# own OOS-validated learn.py report: liquidity>=1.23 was the binding term of an 82%-win
# rule (n=87, z=6.3, held out-of-sample); winners avg 12.8 SOL liq vs losers 3.85. 1.5
# sits just above that floor. For a stricter EV-optimal cut the held-out gate was 15.06
# (+0.632 EV/token) — raise this to A/B that. 0=off.
MOMENTUM_STRUCT_MIN_LIQ_SOL=1.5
# Anti-dump concentration veto (free, no API — approximates holdings from trade flow):
MOMENTUM_MAX_TOP_HOLDER_SHARE=0.0    # reject if top-N traders hold > this share of net float (0=off; try 0.7)
MOMENTUM_TOP_HOLDER_N=10             # how many top traders to sum for the check
MOMENTUM_MAX_CREATOR_SHARE=0.0       # reject if the creator holds > this share of net float (0=off; try 0.15)
MOMENTUM_CONCENTRATION_MIN_TRADERS=25 # only apply the concentration veto once a token has this many holders
                                      # (fresh tokens have few traders, so top-N is ~100% — don't veto too early)
# MELT-inspired insider-distribution veto: skip tokens whose biggest early buyers
# are already selling out (you'd be their exit liquidity — the trash-coin pattern).
MOMENTUM_INSIDER_DISTRIB_MAX_SOLD=0   # veto if top-N early buyers sold > this fraction of what they bought (0=off; try 0.5)
MOMENTUM_INSIDER_DISTRIB_TOP_N=5      # how many top early buyers to check
MOMENTUM_SCALE_OUT_TARGETS=100,200,300,400  # PnL% rungs at which to take profit
MOMENTUM_SCALE_OUT_FRACTIONS=0.2,0.2,0.2,0.2  # fraction of ORIGINAL to sell at each rung (1:1 with targets)
                                     # runner = 1 - sum(fractions), held until collapse/migration.
                                     # bigger wins: keep a fatter runner, e.g. targets 40,150,400,1000
                                     # with fractions 0.2,0.2,0.2,0.1 -> 30% runner rides the moonshots.
MOMENTUM_SLIPPAGE_BPS=1000           # base slippage (bps); fallback for the per-leg values below
MOMENTUM_BUY_SLIPPAGE_BPS=1000       # buy-leg slippage (bps) — tight: a worse fill just skips the entry
MOMENTUM_SELL_SLIPPAGE_BPS=2500      # sell-leg slippage (bps) — LOOSE on purpose so a dump/emergency exit is
                                     #   never REJECTED for slippage (being stuck in a crash is worse than a bad fill)
MOMENTUM_LANDING=zeroslot            # tx landing: zeroslot | jito | multi (jito bundle + RPC, same-sig safe)
MOMENTUM_MIGRATION_EXIT_SOL=82       # exit a held token when curve SOL reserves hit this (about to migrate); 0 disables
MOMENTUM_TRADE_LOG=momentum_trades.csv  # append-only CSV of every buy/sell for PnL analysis
MOMENTUM_ALLOW_REENTRY=true          # allow re-buying a token (after cooldown) if it re-pumps
MOMENTUM_REENTRY_COOLDOWN_SECS=300   # seconds to wait after an exit before re-entering the same token

# ---- Edge: smart-money memory ----
# Learns which wallets' buys precede pumps and biases entries toward them.
# Reputation persists to MOMENTUM_REP_FILE and compounds across runs.
MOMENTUM_SMART_MONEY=true
MOMENTUM_SMART_MONEY_MIN_SOL=0.5      # only track wallets buying at least this much
MOMENTUM_SMART_MONEY_HORIZON_SECS=120 # grade a wallet on the token's return this long after its buy
MOMENTUM_SMART_MONEY_MIN_SAMPLES=3    # reputation samples before a wallet can influence scoring
MOMENTUM_SMART_MONEY_BOOST_MAX=15     # max score points smart-money confirmation adds (0..100 scale)
MOMENTUM_SMART_MONEY_BOOST_SCALE=1.0  # sum of buyer reputations earning the full boost
MOMENTUM_SMART_MONEY_HALFLIFE_SECS=604800  # reputation half-life (7d): stale wallets fade, recent results dominate
MOMENTUM_REP_FILE=momentum_wallet_rep.csv

# ---- Edge: alpha-follow (the bot ACTS on its learned memory) ----
# When a single wallet the bot has LEARNED is reliable (high reputation over enough
# graded buys) buys a token, treat it as a high-conviction entry: big score boost +
# size up. This is the memory in action and it compounds — more wallets cross the
# bar the longer the bot runs. Export the proven wallets with scripts/rep_to_kol.py.
MOMENTUM_ALPHA_FOLLOW=true            # follow wallets the bot learned are proven winners
MOMENTUM_ALPHA_REP_MIN=0.5            # legacy EMA-reputation knob (still recorded; gate now uses the score below)
MOMENTUM_ALPHA_MIN_WALLET_SCORE=60    # min recency-weighted wallet score (0..100) to follow. 60=WATCHLIST+.
                                      # score = 0.5*recent50 + 0.3*recent200 + 0.2*lifetime winrate, confidence-adjusted.
                                      # tiers: 90 ELITE / 75 STRONG / 60 WATCHLIST / 40 WEAK / <40 AVOID
MOMENTUM_ALPHA_MIN_SAMPLES=5          # min graded buys before a wallet can be followed
MOMENTUM_ALPHA_BOOST=35               # entry-score points added when a proven wallet is buying
MOMENTUM_ALPHA_WINDOW_SECS=60         # how long a proven-wallet buy keeps a token "hot"
MOMENTUM_ALPHA_SIZE_MULT=1.5          # position-size multiple when following a proven wallet (KOL or alpha)
# Convergence: several PROVEN wallets net-accumulating the same token at once — the
# most reliable smart-money signal (vs one wallet's single buy). Alpha now requires
# net accumulation (buys - sells), not just one buy tick.
MOMENTUM_CONVERGENCE_MIN=2            # distinct proven wallets accumulating to call it convergence
MOMENTUM_CONVERGENCE_BOOST=55         # entry-score boost when convergence fires (vs ALPHA_BOOST for one)
MOMENTUM_CONVERGENCE_SIZE_MULT=1.5    # extra size multiple on top of ALPHA_SIZE_MULT when convergence fires

# ---- "Ones to Watch": high-conviction composite watchlist ----
# Composite of (1) market structure (vol/mc, momentum structure, liquidity) and
# (2) smart-money convergence (proven wallets accumulating). BETA: alert-only until
# learn.py validates it; then flip AUTOBUY to buy these at the larger watch size.
MOMENTUM_WATCH_ENABLED=true
MOMENTUM_WATCH_SCORE=70               # composite (0..100) to flag a token as one-to-watch
MOMENTUM_WATCH_MS_WEIGHT=0.5          # weight on market-structure half (rest = convergence)
# HARD watchlist floors — keep TRASH off "Ones to Watch". These are gates, not soft
# score inputs: a token must clear EVERY one (on top of the composite score above) or it
# never appears on the watchlist, no matter how high its momentum score is.
MOMENTUM_WATCH_MIN_LIQ_SOL=8.0        # liquidity LOCK: min bonding-curve SOL (must be exitable)
MOMENTUM_WATCH_MIN_VOL_SOL=3.0        # volume floor: min short-window buy volume (SOL)
MOMENTUM_WATCH_REQUIRE_WHALE=true     # require a whale OR proven smart money OR convergence
MOMENTUM_WATCH_WHALE_SOL=5.0          # a single buy >= this counts as a whale positioning
MOMENTUM_WATCH_MAX_CONCENTRATION=0.80 # reject if the top holder owns > this share (insider/bundler); 0=off
# Runner-DNA bridge: the watchlist scores tokens by how well they match the VALIDATED
# runner patterns learned by scripts/runner_research.py (runner_patterns.json). Off until
# the research layer proves patterns; then it steers "Ones to Watch" toward the runner DNA.
MOMENTUM_WATCH_DNA_WEIGHT=0.40        # how much the validated-pattern match shifts the watch score (0=bridge off)
MOMENTUM_WATCH_DNA_MIN_CONF=0.30      # min knowledge-base confidence for a pattern to be used live
MOMENTUM_RUNNER_PATTERNS_FILE=runner_patterns.json  # the research knowledge base (read live, reloaded ~hourly)
# Early-warning pump alerts: fire NAMED pre-pump signals to Telegram BEFORE a move (smart-money
# accumulation, whale positioning, organic momentum, holder growth, breakout). Proactive, not
# reactive. Only fires when >= MIN_SIGNALS stack (rare by design); deduped per token.
MOMENTUM_PUMP_ALERTS=true             # master switch for the early-warning alerts
MOMENTUM_PUMP_ALERT_WHALE_SOL=1.0     # single-window buy volume (SOL) that counts as whale positioning
MOMENTUM_PUMP_ALERT_BREADTH=12        # distinct buyers in the window that counts as abnormal holder growth
MOMENTUM_PUMP_ALERT_YOUNG_SECS=300    # only flag "early" signals on tokens younger than this
MOMENTUM_PUMP_ALERT_MIN_SIGNALS=2     # how many signals must stack before alerting (>=3 = MAJOR PUMP INCOMING)
MOMENTUM_PUMP_ALERT_COOLDOWN_SECS=1800 # don't re-alert the same token within this window
MOMENTUM_WATCH_AUTOBUY=false          # false=alert+track only (beta). true=auto-buy at watch size
MOMENTUM_WATCH_SIZE_SOL=0.5           # larger position for watch auto-buys (vs the usual size)

# ---- Edge: insider / leader-dump exit ----
# Tracks the creator + top early buyers; exits the instant they start distributing.
MOMENTUM_LEADER_DUMP_EXIT=true
MOMENTUM_LEADER_TRACK_TOP_N=5         # number of top early buyers to track (plus the creator)
MOMENTUM_LEADER_DUMP_SOL=1.0          # tracked-wallet sells (SOL, short window) that trigger exit
MOMENTUM_LEADER_DUMP_FRACTION=0.6     # RUNNER CAPTURE: sell only 60% on an insider dump, keep 40% riding the
                                      # trailing stop into the moonshot tail (1.0=full exit, the old behavior)
MOMENTUM_SLOW_RUG_SOL=0.0             # SLOW-RUG exit: total SOL the creator+early wallets may sell over the
                                      # WHOLE hold before we bail — catches steady drip distribution that never
                                      # trips LEADER_DUMP_SOL in one window. 0=off; try ~1.5-2x LEADER_DUMP_SOL.

# ---- Edge: trailing stop (let winners run) ----
# Stops the bot dumping the whole bag on the first wobble. Once a position's peak
# PnL clears the activation %, it rides and only exits when it gives back a chunk
# of that peak — so a token that keeps pumping is held instead of sold early.
MOMENTUM_TRAIL_ENABLED=true
MOMENTUM_TRAIL_ACTIVATE_PCT=50        # arm the trail once peak PnL reaches this %
MOMENTUM_TRAIL_GIVEBACK_FRAC=0.45     # RUNNER CAPTURE: exit only after giving back 45% of the peak gain (wider
                                      # = rides winners further; 0.35 was tighter and sold rockets earlier)
                                      # (peak +200% with 0.35 -> exit ~+130%). Armed winners also
                                      # ignore the momentum-collapse dump so brief dips don't bail.

# ---- Edge: KOL tracking (YOUR private edge — a curated wallet list) ----
# Buys from wallets on your list become a leading entry signal; momentum/LP/
# anti-fake/security still confirm. The analyzer attributes PnL per KOL so you
# prune the list over time (keep winners, cut losers) — that loop is the edge.
MOMENTUM_KOL_ENABLED=false            # turn on once you have a kol_wallets.txt
MOMENTUM_KOL_FILE=kol_wallets.txt     # one wallet per line: wallet[,weight][,label]
MOMENTUM_KOL_BOOST=40                 # entry-score points added per unit weight when a KOL buys
MOMENTUM_KOL_WINDOW_SECS=60           # how long a KOL buy keeps a token "hot"
MOMENTUM_KOL_REQUIRE=false            # true = ONLY enter tokens a KOL bought (pure-KOL mode)
MOMENTUM_KOL_RELOAD_SECS=0            # >0 = hot-reload kol_wallets.txt every N sec (pair with a cron'd Dune fetch)
MOMENTUM_STATUS_FILE=momentum_status.json  # live snapshot for the web dashboard ("" to disable)
# ---- Remote alerting (Telegram) — push notifications while running unattended ----
# Both must be set to arm alerts (no-op if unset). Alerts fire on: bot online, circuit-
# breaker halt, margin call, token quarantine, and manual/external-sell reconcile.
# Create a bot via @BotFather for the token; get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=                   # e.g. 123456:ABC-DEF... (keep secret; .env is gitignored)
TELEGRAM_CHAT_ID=                     # your numeric chat id (where alerts are sent)
MOMENTUM_POSITIONS_FILE=momentum_positions.json  # open positions persisted here for crash recovery ("" to disable)
                                     # on restart the bot re-adopts these and resumes stop-loss / scale-out.
MOMENTUM_DECISION_LOG=momentum_decisions  # base path for the learning log ("" to disable). Records EVERY
                                     # token evaluation -> <base>.csv + .jsonl, and a labeled outcome per
                                     # token -> <base>_outcomes.csv. Analyze with: python3 scripts/learn.py
MOMENTUM_OUTCOME_HORIZON_SECS=7200   # how long to track each token before labeling its outcome (2h default).
                                     # raise it (e.g. 21600 = 6h) to capture bigger/slower pumps for research.

# ---- Edge: conviction-based sizing ----
# Scale position size up with how far the entry score clears the bar.
MOMENTUM_CONVICTION_SIZING=false      # off by default (keeps size predictable at 0.2 SOL)
MOMENTUM_CONVICTION_MAX_MULT=2.0      # max size multiple at very high scores
MOMENTUM_SMART_MONEY_MIN_DISTINCT=2   # distinct reputable wallets required before any smart-money boost

# ---- Edge: fractional-Kelly sizing (the CALCULATED scale-up — bet bigger on real edge) ----
# When on, size each bet by its measured edge via Kelly: f* = p - (1-p)/b. We bet a
# FRACTION of full Kelly and clamp hard, so big bets happen only on genuinely big edges
# and a noisy estimate can't blow up the account. Replaces the linear multiple above.
# Each entry logs "📈 Kelly size … conviction → p% · f% → size (Nx base)" so you can see it.
# Off by default — it's a sizing change, A/B it (MOMENTUM_KELLY_SIZING=true) one window.
# Defaults are data-anchored, not arbitrary (see the learn.py report):
MOMENTUM_KELLY_SIZING=false           # master switch
MOMENTUM_KELLY_FRACTION=0.30          # fraction of full Kelly to bet (0.30 = conservative "30% Kelly")
MOMENTUM_KELLY_MAX_FRACTION=0.25      # hard ceiling: max share of equity in one bet
MOMENTUM_KELLY_PAYOFF_B=2.5           # payoff ratio (avg win/avg loss); conservative vs ~2.7x realized
MOMENTUM_KELLY_P_FLOOR=0.35           # win prob at min conviction = realized baseline win rate
MOMENTUM_KELLY_P_CEILING=0.80         # win prob at max conviction = alpha/high-conviction win rate (~83%)
MOMENTUM_KELLY_LIQ_REF=15.0           # liquidity (SOL) at which the conviction liq-term saturates (EV-optimal gate)

# ---- Edge: ADAPTIVE sizing (capital-preservation-first; supersedes flat Kelly) ----
# The full risk pipeline: ensemble win-prob (momentum/smart-money/liquidity/structure/whale/
# creator) → Bayesian update vs your realized wins/losses → EV gate → theoretical Kelly →
# uncertainty-shrunk fractional Kelly → portfolio/correlation cut → drawdown throttle → hard
# risk filter. It can SKIP a trade — capital preservation always overrides opportunity. Every
# entry logs the full breakdown (ens p → bayes p, EV, Kelly%, frac%, port×, dd×, conf, risk).
# Off by default — it's a sizing change, A/B it. When on it takes precedence over KELLY_SIZING.
MOMENTUM_ADAPTIVE_SIZING=false
MOMENTUM_ADAPTIVE_PRIOR_K=25           # Bayesian prior strength (pseudo-trades before realized data dominates)
MOMENTUM_ADAPTIVE_MIN_CONFIDENCE=0.30  # skip if posterior confidence is below this
MOMENTUM_ADAPTIVE_MIN_EV_R=0.0         # skip if expected value (in R) is at/below this
# AUTO-CALIBRATION: learn.py measures your REAL win rates + payoff and writes
# sizing_calibration.json; the bot hot-reloads it and the sizer bets on reality instead of
# the static p_floor/p_ceiling/payoff_b defaults. This feeds ONLY the sizing math — it never
# changes the edge, entry signals, vetoes, or exits. (daily_report.sh runs learn.py, which
# writes the file; the bot reloads it every ~60s — no restart, no manual paste.)
MOMENTUM_SIZING_AUTOCALIBRATE=true     # use learn.py's calibrated p/payoff when available
MOMENTUM_SIZING_CALIBRATION_FILE=sizing_calibration.json
MOMENTUM_SIZING_MIN_SAMPLES=50         # min labeled tokens before the bot trusts a calibration
# (drawdown throttle is the policy table: <5% full, 5-10% 0.75x, 10-15% 0.50x, 15-20% 0.25x,
#  20-25% 0.10x, 25-30% emergency, >30% STOP. Reuses MOMENTUM_KELLY_MAX_FRACTION as the cap.)

# ---- Risk controls ----
MOMENTUM_MAX_DEPLOYED_SOL=1.0         # hard cap on total SOL exposed (used when START_CAPITAL=0)
MOMENTUM_START_CAPITAL_SOL=0          # >0 = REAL bankroll sim: equity = start + realized PnL, deploy only
                                      # what you have, compounds on profit, MARGIN CALL when broke. e.g. 1.0
                                      # (pair with POSITION_SIZE_PCT so bets scale with the account)
MOMENTUM_BANKRUPTCY_FLOOR_FRAC=0.10   # margin call when equity drops below this fraction of start (0.10 = lost 90%)
MOMENTUM_BUY_COST_FRACTION=0.015      # estimated entry cost (fees+tip+slippage) folded into cost basis
MOMENTUM_FEE_RESERVE_SOL=0.02         # keep this much SOL for fees/tips; skip a live buy if balance < size + reserve
MOMENTUM_MAX_SELL_RETRIES=8           # quarantine + alert a position after this many failed sells (0=never; likely illiquid/honeypot)

# ---- Discipline: circuit breaker + go-live gate ----
# When the data edge is shared, discipline is the edge. These HALT new entries
# (open positions still exit normally) so a bad session can't blow up the account.
MOMENTUM_DAILY_LOSS_LIMIT_SOL=0.15    # halt new entries once the DAY's realized PnL hits -this (0 disables)
                                      # (tuned: worst dry-run drawdown was -0.086 SOL; 0.15 gives headroom)
MOMENTUM_MAX_CONSECUTIVE_LOSSES=20    # halt after this many losing full exits in a row (0 disables)
                                      # (tuned: dry run hit a 14-loss streak; 6 would have halted a profitable run)
MOMENTUM_DAILY_RESET=true             # auto-reset the breaker (loss limit + streak) at each day boundary
MOMENTUM_DAILY_RESET_UTC_OFFSET_HOURS=0  # hour offset from UTC for when the trading day rolls over
# Live trading is refused unless you explicitly confirm (prevents accidental live runs).
MOMENTUM_LIVE_CONFIRM=false           # must be true (with MOMENTUM_DRY_RUN=false) to trade real money
# SECURITY TRIPWIRE: refuse to start LIVE if the wallet holds more than this (SOL). Guards
# against ever auto-signing on your MAIN wallet. Set it just above your hot-wallet float
# (e.g. 2.0 for a ~1 SOL bankroll). 0 = disabled. Strongly recommended for live.
MOMENTUM_MAX_WALLET_SOL=0
# Anti-tamper guard: refuse to sign any tx that invokes a program outside the canonical
# pump.fun set (swap + SPL token + ATA + compute-budget + system tip). Defense-in-depth so
# a poisoned dependency/feed can never make the bot sign a wallet-draining transaction.
# Leave ON. Only set false if a legitimate new program ever trips a false positive.
MOMENTUM_GUARD_PROGRAMS=true
# Honeypot pre-check: read each token's SPL mint before buying and skip it if the FREEZE
# authority is live (creator can freeze your account → you can never sell) or the MINT
# authority is live (supply can be inflated to dilute/rug). Legit pump.fun tokens renounce
# both at creation, so this only catches anomalies. Fails open on RPC errors. Leave ON.
MOMENTUM_AUTHORITY_CHECK=true
# Pre-send simulation: simulate each buy/sell against the RPC before broadcasting and skip
# it if it would revert (proves sellability — catches honeypots / sell-path reverts before
# spending a real tx). Adds an RPC round-trip per trade (latency), so OFF by default; turn
# ON for cautious live runs (especially the first tiny live test).
MOMENTUM_PRESEND_SIMULATE=false

# ---- GMGN integration (smart-money + rug veto + trenches) ----
# Generate an API key at https://gmgn.ai/ai . The OpenAPI is open to all users.
# All GMGN features degrade gracefully: if GMGN is slow/down, the bot falls back
# to its own signals. Confirm the auth header your key needs (AUTH_HEADER/PREFIX).
GMGN_ENABLED=false                    # master switch for all GMGN features — set true + add a key to arm the
                                      #   bundle/rug vetoes below (the only way to catch funded bundler clusters)
GMGN_API_KEY=                         # your GMGN X-APIKEY value (from gmgn.ai/ai dashboard; NOT the public key)
GMGN_BASE_URL=https://api.gmgn.ai     # confirm from your GMGN account
GMGN_AUTH_HEADER=X-APIKEY             # GMGN normal-auth header for read endpoints (no signing needed)
GMGN_AUTH_PREFIX=                     # empty for GMGN (the X-APIKEY value is sent raw)
GMGN_CHAIN=sol
GMGN_TIMEOUT_MS=1500                  # per-request timeout
GMGN_SECURITY_VETO=true               # veto buys flagged honeypot / high rug_ratio
GMGN_MAX_RUG_RATIO=0.3                # reject if rug_ratio exceeds this (0..1)
GMGN_MAX_TOP10_HOLDER_RATE=1.0        # reject if top-10 holders exceed this share (0..1); 1.0=off, try 0.20
GMGN_MAX_BUNDLE_RATE=0.20             # reject if bundled/sniped supply > this share (0..1); ON by default (0.20).
                                      #   Active only when GMGN_ENABLED + key; fails open on unknown tokens.
GMGN_VETO_ON_UNKNOWN=false            # true = block buy when security lookup fails (fail-closed)
GMGN_SECURITY_CACHE_SECS=120          # cache security verdicts to cut latency/rate-limit
MOMENTUM_GMGN_BOOST=12                # score points added when a mint is on GMGN's hot watchlist
MOMENTUM_GMGN_POLL_SECS=15            # how often to refresh smartmoney + trenches
MOMENTUM_GMGN_TRENCHES_PRESET=smart-money  # safe | smart-money | strict
MOMENTUM_GMGN_WATCHLIST_TTL_SECS=300  # how long a hot mint stays boosted
MOMENTUM_GMGN_SMARTMONEY_LIMIT=100    # smartmoney trades pulled per poll

# Target Wallet Monitoring Configuration (used when MONITORING_MODE=copy)
COPY_TRADING_TARGET_ADDRESS=
IS_MULTI_COPY_TRADING=true
COUNTER_LIMIT=10  # Increase this to allow monitoring more tokens simultaneously

# Trading Configuration
TOKEN_AMOUNT=0.001 # token amount to purchase
BUY_IN_SELL=0.02
BUY_IN_SELL_LIMIT=30 # if target sell token for more than 10 sol, buy BUY_IN_SELL amount of token

# Performance Settings
UNIT_PRICE=2000000
