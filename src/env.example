# ============================================================
# MODE SELECTION
# ============================================================
# "copy"     -> original copy-trading / target-wallet sniper (requires COPY_TRADING_TARGET_ADDRESS)
# "momentum" -> pump.fun momentum sniper: buys strength not age, no copy-trading
MONITORING_MODE=momentum

# Momentum data feed: "grpc" (Yellowstone, fastest, needs a gRPC endpoint) or
# "ws" (standard RPC websocket blockSubscribe — works on Chainstack/Helius wss
# WITHOUT gRPC or a Business plan). For "ws", set RPC_WSS below.
MOMENTUM_FEED=grpc
RPC_WSS=wss://your-websocket-endpoint   # used only when MOMENTUM_FEED=ws

# ============================================================
# MOMENTUM SNIPER (used when MONITORING_MODE=momentum)
# Buys statistically significant momentum regardless of token age/lifecycle.
# ============================================================
# DRY RUN: paper-trade with no transactions sent. Runs the full strategy on the
# live stream, simulates fills at market cap minus SIM_COST_FRACTION, and logs to
# the trade CSV. Validate the edge here before going live. Set to false for real money.
MOMENTUM_DRY_RUN=true
MOMENTUM_SIM_COST_FRACTION=0.03      # simulated round-trip cost per fill (0.03 = 3%: fees+tip+slippage)

MOMENTUM_POSITION_SIZE_SOL=0.2       # fixed SOL per trade (used when POSITION_SIZE_PCT=0)
MOMENTUM_POSITION_SIZE_PCT=0         # >0 = size as a FRACTION of equity (bankroll mode); scales up as you
                                     # win, down as you lose. e.g. 0.05 = 5% of equity per position
MOMENTUM_MAX_POSITIONS=5             # max concurrent positions
MOMENTUM_ENTRY_SCORE=57              # 0..100 continuation-probability score required to buy
                                     # (tuned: dry-run winners avg ~58, losers ~54 — sits between them)
MOMENTUM_MIN_BASE_SCORE=0            # min BASE momentum score before boosts (0=off). Stops KOL/alpha
                                     # boosts dragging in weak tokens. Try 50 to lift win rate.
MOMENTUM_STAGNATION_SECS=0           # cut a position that never reaches MIN_PNL within this many secs
                                     # (0=off). Kills dead tokens before they bleed into a hard stop.
MOMENTUM_STAGNATION_MIN_PNL=20       # the "never got going" threshold for the stagnation stop (% PnL)
MOMENTUM_COLLAPSE_SCORE=35           # below this score, cut the position (failed momentum)
MOMENTUM_HARD_STOP_PCT=-35           # hard stop loss (% from entry market cap)
MOMENTUM_SHORT_WINDOW_SECS=30        # "now" window for momentum
MOMENTUM_MEDIUM_WINDOW_SECS=120      # baseline window for acceleration
MOMENTUM_MIN_BUY_VOLUME_SOL=2.0      # short-window buy volume that scores full marks
MOMENTUM_TARGET_UNIQUE_BUYERS=10     # short-window unique buyers that scores full marks
MOMENTUM_TARGET_MCAP_GROWTH=0.30     # short-window mcap growth that scores full marks (0.30 = 30%)
MOMENTUM_MAX_WALLET_CONCENTRATION=0.50  # max single-wallet share of buy volume before penalty
# Anti-fake / manufactured-momentum hardening:
MOMENTUM_MIN_BUYER_DIVERSITY=0.35    # min (unique buyers / buy txns); below this volume looks spammed
MOMENTUM_MAX_WASH_FRACTION=0.40      # max share of buy volume from wallets that also sold (wash trading)
# Anti-dump concentration veto (free, no API — approximates holdings from trade flow):
MOMENTUM_MAX_TOP_HOLDER_SHARE=0.0    # reject if top-N traders hold > this share of net float (0=off; try 0.7)
MOMENTUM_TOP_HOLDER_N=10             # how many top traders to sum for the check
MOMENTUM_MAX_CREATOR_SHARE=0.0       # reject if the creator holds > this share of net float (0=off; try 0.15)
MOMENTUM_CONCENTRATION_MIN_TRADERS=25 # only apply the concentration veto once a token has this many holders
                                      # (fresh tokens have few traders, so top-N is ~100% — don't veto too early)
MOMENTUM_SCALE_OUT_TARGETS=100,200,300,400  # PnL% rungs at which to take profit
MOMENTUM_SCALE_OUT_FRACTIONS=0.2,0.2,0.2,0.2  # fraction of ORIGINAL to sell at each rung (1:1 with targets)
                                     # runner = 1 - sum(fractions), held until collapse/migration.
                                     # bigger wins: keep a fatter runner, e.g. targets 40,150,400,1000
                                     # with fractions 0.2,0.2,0.2,0.1 -> 30% runner rides the moonshots.
MOMENTUM_SLIPPAGE_BPS=1000           # slippage for momentum buys/sells (basis points)
MOMENTUM_LANDING=zeroslot            # tx landing: zeroslot | jito | multi (jito bundle + RPC, same-sig safe)
MOMENTUM_MIGRATION_EXIT_SOL=82       # exit a held token when curve SOL reserves hit this (about to migrate); 0 disables
MOMENTUM_TRADE_LOG=momentum_trades.csv  # append-only CSV of every buy/sell for PnL analysis
MOMENTUM_ALLOW_REENTRY=true          # allow re-buying a token (after cooldown) if it re-pumps
MOMENTUM_REENTRY_COOLDOWN_SECS=300   # seconds to wait after an exit before re-entering the same token

# ---- Edge: smart-money memory ----
# Learns which wallets' buys precede pumps and biases entries toward them.
# Reputation persists to MOMENTUM_REP_FILE and compounds across runs.
MOMENTUM_SMART_MONEY=true
MOMENTUM_SMART_MONEY_MIN_SOL=0.5      # only track wallets buying at least this much
MOMENTUM_SMART_MONEY_HORIZON_SECS=120 # grade a wallet on the token's return this long after its buy
MOMENTUM_SMART_MONEY_MIN_SAMPLES=3    # reputation samples before a wallet can influence scoring
MOMENTUM_SMART_MONEY_BOOST_MAX=15     # max score points smart-money confirmation adds (0..100 scale)
MOMENTUM_SMART_MONEY_BOOST_SCALE=1.0  # sum of buyer reputations earning the full boost
MOMENTUM_SMART_MONEY_HALFLIFE_SECS=604800  # reputation half-life (7d): stale wallets fade, recent results dominate
MOMENTUM_REP_FILE=momentum_wallet_rep.csv

# ---- Edge: alpha-follow (the bot ACTS on its learned memory) ----
# When a single wallet the bot has LEARNED is reliable (high reputation over enough
# graded buys) buys a token, treat it as a high-conviction entry: big score boost +
# size up. This is the memory in action and it compounds — more wallets cross the
# bar the longer the bot runs. Export the proven wallets with scripts/rep_to_kol.py.
MOMENTUM_ALPHA_FOLLOW=true            # follow wallets the bot learned are proven winners
MOMENTUM_ALPHA_REP_MIN=0.5            # min learned reputation (EMA of forward returns) to follow
MOMENTUM_ALPHA_MIN_SAMPLES=5          # min graded buys before a wallet can be followed
MOMENTUM_ALPHA_BOOST=35               # entry-score points added when a proven wallet is buying
MOMENTUM_ALPHA_WINDOW_SECS=60         # how long a proven-wallet buy keeps a token "hot"
MOMENTUM_ALPHA_SIZE_MULT=1.5          # position-size multiple when following a proven wallet (KOL or alpha)

# ---- Edge: insider / leader-dump exit ----
# Tracks the creator + top early buyers; exits the instant they start distributing.
MOMENTUM_LEADER_DUMP_EXIT=true
MOMENTUM_LEADER_TRACK_TOP_N=5         # number of top early buyers to track (plus the creator)
MOMENTUM_LEADER_DUMP_SOL=1.0          # tracked-wallet sells (SOL, short window) that trigger exit
MOMENTUM_LEADER_DUMP_FRACTION=1.0     # how much of the position to sell on an insider dump (1.0=full exit;
                                      # lower, e.g. 0.6, keeps a runner that rides the trailing stop)

# ---- Edge: trailing stop (let winners run) ----
# Stops the bot dumping the whole bag on the first wobble. Once a position's peak
# PnL clears the activation %, it rides and only exits when it gives back a chunk
# of that peak — so a token that keeps pumping is held instead of sold early.
MOMENTUM_TRAIL_ENABLED=true
MOMENTUM_TRAIL_ACTIVATE_PCT=50        # arm the trail once peak PnL reaches this %
MOMENTUM_TRAIL_GIVEBACK_FRAC=0.35     # exit after giving back this fraction of the peak gain
                                      # (peak +200% with 0.35 -> exit ~+130%). Armed winners also
                                      # ignore the momentum-collapse dump so brief dips don't bail.

# ---- Edge: KOL tracking (YOUR private edge — a curated wallet list) ----
# Buys from wallets on your list become a leading entry signal; momentum/LP/
# anti-fake/security still confirm. The analyzer attributes PnL per KOL so you
# prune the list over time (keep winners, cut losers) — that loop is the edge.
MOMENTUM_KOL_ENABLED=false            # turn on once you have a kol_wallets.txt
MOMENTUM_KOL_FILE=kol_wallets.txt     # one wallet per line: wallet[,weight][,label]
MOMENTUM_KOL_BOOST=40                 # entry-score points added per unit weight when a KOL buys
MOMENTUM_KOL_WINDOW_SECS=60           # how long a KOL buy keeps a token "hot"
MOMENTUM_KOL_REQUIRE=false            # true = ONLY enter tokens a KOL bought (pure-KOL mode)
MOMENTUM_KOL_RELOAD_SECS=0            # >0 = hot-reload kol_wallets.txt every N sec (pair with a cron'd Dune fetch)
MOMENTUM_STATUS_FILE=momentum_status.json  # live snapshot for the web dashboard ("" to disable)
MOMENTUM_POSITIONS_FILE=momentum_positions.json  # open positions persisted here for crash recovery ("" to disable)
                                     # on restart the bot re-adopts these and resumes stop-loss / scale-out.

# ---- Edge: conviction-based sizing ----
# Scale position size up with how far the entry score clears the bar.
MOMENTUM_CONVICTION_SIZING=false      # off by default (keeps size predictable at 0.2 SOL)
MOMENTUM_CONVICTION_MAX_MULT=2.0      # max size multiple at very high scores
MOMENTUM_SMART_MONEY_MIN_DISTINCT=2   # distinct reputable wallets required before any smart-money boost

# ---- Risk controls ----
MOMENTUM_MAX_DEPLOYED_SOL=1.0         # hard cap on total SOL exposed (used when START_CAPITAL=0)
MOMENTUM_START_CAPITAL_SOL=0          # >0 = REAL bankroll sim: equity = start + realized PnL, deploy only
                                      # what you have, compounds on profit, MARGIN CALL when broke. e.g. 1.0
                                      # (pair with POSITION_SIZE_PCT so bets scale with the account)
MOMENTUM_BANKRUPTCY_FLOOR_FRAC=0.10   # margin call when equity drops below this fraction of start (0.10 = lost 90%)
MOMENTUM_BUY_COST_FRACTION=0.015      # estimated entry cost (fees+tip+slippage) folded into cost basis
MOMENTUM_FEE_RESERVE_SOL=0.02         # keep this much SOL for fees/tips; skip a live buy if balance < size + reserve
MOMENTUM_MAX_SELL_RETRIES=8           # quarantine + alert a position after this many failed sells (0=never; likely illiquid/honeypot)

# ---- Discipline: circuit breaker + go-live gate ----
# When the data edge is shared, discipline is the edge. These HALT new entries
# (open positions still exit normally) so a bad session can't blow up the account.
MOMENTUM_DAILY_LOSS_LIMIT_SOL=0.15    # halt new entries once the DAY's realized PnL hits -this (0 disables)
                                      # (tuned: worst dry-run drawdown was -0.086 SOL; 0.15 gives headroom)
MOMENTUM_MAX_CONSECUTIVE_LOSSES=20    # halt after this many losing full exits in a row (0 disables)
                                      # (tuned: dry run hit a 14-loss streak; 6 would have halted a profitable run)
MOMENTUM_DAILY_RESET=true             # auto-reset the breaker (loss limit + streak) at each day boundary
MOMENTUM_DAILY_RESET_UTC_OFFSET_HOURS=0  # hour offset from UTC for when the trading day rolls over
# Live trading is refused unless you explicitly confirm (prevents accidental live runs).
MOMENTUM_LIVE_CONFIRM=false           # must be true (with MOMENTUM_DRY_RUN=false) to trade real money

# ---- GMGN integration (smart-money + rug veto + trenches) ----
# Generate an API key at https://gmgn.ai/ai . The OpenAPI is open to all users.
# All GMGN features degrade gracefully: if GMGN is slow/down, the bot falls back
# to its own signals. Confirm the auth header your key needs (AUTH_HEADER/PREFIX).
GMGN_ENABLED=false                    # master switch for all GMGN features
GMGN_API_KEY=                         # your GMGN X-APIKEY value (from gmgn.ai/ai dashboard; NOT the public key)
GMGN_BASE_URL=https://api.gmgn.ai     # confirm from your GMGN account
GMGN_AUTH_HEADER=X-APIKEY             # GMGN normal-auth header for read endpoints (no signing needed)
GMGN_AUTH_PREFIX=                     # empty for GMGN (the X-APIKEY value is sent raw)
GMGN_CHAIN=sol
GMGN_TIMEOUT_MS=1500                  # per-request timeout
GMGN_SECURITY_VETO=true               # veto buys flagged honeypot / high rug_ratio
GMGN_MAX_RUG_RATIO=0.3                # reject if rug_ratio exceeds this (0..1)
GMGN_MAX_TOP10_HOLDER_RATE=1.0        # reject if top-10 holders exceed this share (0..1); 1.0=off, try 0.20
GMGN_MAX_BUNDLE_RATE=1.0              # reject if bundled/sniped supply exceeds this share (0..1); 1.0=off, try 0.20
GMGN_VETO_ON_UNKNOWN=false            # true = block buy when security lookup fails (fail-closed)
GMGN_SECURITY_CACHE_SECS=120          # cache security verdicts to cut latency/rate-limit
MOMENTUM_GMGN_BOOST=12                # score points added when a mint is on GMGN's hot watchlist
MOMENTUM_GMGN_POLL_SECS=15            # how often to refresh smartmoney + trenches
MOMENTUM_GMGN_TRENCHES_PRESET=smart-money  # safe | smart-money | strict
MOMENTUM_GMGN_WATCHLIST_TTL_SECS=300  # how long a hot mint stays boosted
MOMENTUM_GMGN_SMARTMONEY_LIMIT=100    # smartmoney trades pulled per poll

# Target Wallet Monitoring Configuration (used when MONITORING_MODE=copy)
COPY_TRADING_TARGET_ADDRESS=
IS_MULTI_COPY_TRADING=true
COUNTER_LIMIT=10  # Increase this to allow monitoring more tokens simultaneously

# Trading Configuration
TOKEN_AMOUNT=0.001 # token amount to purchase
BUY_IN_SELL=0.02
BUY_IN_SELL_LIMIT=30 # if target sell token for more than 10 sol, buy BUY_IN_SELL amount of token

# Performance Settings
UNIT_PRICE=2000000
UNIT_LIMIT=2000000
SELLING_UNIT_PRICE=4000000
SELLING_UNIT_LIMIT=2000000
ZERO_SLOT_TIP_VALUE=0.0025

# Sniper Bot Focus Token Settings
# If a focus token's price drops by this fraction from its initial price, mark as dropped
# e.g. 0.15 means 15% drop
FOCUS_DROP_THRESHOLD_PCT=0.15
# After drop, trigger buy if an observed buy is at least this many SOL
FOCUS_TRIGGER_SOL=1.0

# Selling Strategy
COPY_SELLING_LIMIT=1.5
TAKE_PROFIT=8.0 # Take profit percentage
STOP_LOSS=-2   # Stop loss percentage
MAX_HOLD_TIME=3600 # Maximum hold time in seconds
DYNAMIC_RETRACEMENT_PERCENTAGE=15
RETRACEMENT_PNL_THRESHOLD=15
RETRACEMENT_THRESHOLD=15
MIN_LIQUIDITY=4

# Dynamic Trailing Stop Configuration
TRAILING_STOP_ACTIVATION_PERCENTAGE=20.0  # Minimum PnL to activate trailing stop
TRAILING_STOP_TRAIL_PERCENTAGE=10.0       # Fallback trailing stop percentage
# Format: "pnl_threshold:trail_percentage,pnl_threshold:trail_percentage,..."
# Default: 20:5,50:10,100:30,200:100,500:100,1000:100
DYNAMIC_TRAILING_STOP_THRESHOLDS=20:5,50:10,100:30,200:100,500:100,1000:100

# Transaction Settings
TRANSACTION_LANDING_SERVICE=0
SLIPPAGE=3000
MAX_WAIT_TIME=650000 # 600 seconds
TIME_EXCEED=10 # seconds; time limit for volume non-increasing

# Excluded Addresses
EXCLUDED_ADDRESSES=
# RPC Configuration
RPC_HTTP=https://rpc.shyft.to?api_key=YOUR_API_KEY
RPC_WSS=wss://mainnet-fra.fountainhead.land/
YELLOWSTONE_GRPC_HTTP=https://grpc.ny.shyft.to
YELLOWSTONE_GRPC_TOKEN=YOUR_GRPC_TOKEN

# ZeroSlot Configuration
ZERO_SLOT_URL=http://ny1.0slot.trade/?api-key=YOUR_API_KEY
ZERO_SLOT_HEALTH=https://ny1.0slot.trade/health
ZERO_SLOT_TIP_VALUE=0.00015
JITO_TIP_VALUE=0.001

# Wallet Configuration
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
WRAP_AMOUNT=0.5  # 0.12 sol JITO_TIP_VALUE=0.001            # SOL tip for Jito bundles (jito/multi landing)
JITO_BLOCK_ENGINE=https://mainnet.block-engine.jito.wtf/api/v1/bundles
