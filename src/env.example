# ---- Whole-market pump scanner (scripts/pump_scanner.py — separate from the bot) ----
BIRDEYE_API_KEY=                      # birdeye.so API key for the market-wide pump scanner/autopsy

# ---- Market Watch: whole-market "Ones to Watch" (scripts/market_watch.py) ----
# ISOLATED from the sniper — a separate process that scans the ENTIRE market via Birdeye
# (real liquidity/volume/holders), not pre-bonding pump.fun tokens. Needs BIRDEYE_API_KEY.
# Strict by default so trash/rugs never show up; loosen if the list is too quiet.
MARKET_MIN_LIQ_USD=20000              # min real liquidity (USD) — must be exitable
MARKET_MIN_VOL24_USD=50000           # min 24h volume (USD) — real turnover
MARKET_MIN_HOLDERS=200               # min holders — a crowd, not a rug of 5 wallets
MARKET_MIN_MC_USD=50000              # floor market cap (no dust)
MARKET_MAX_MC_USD=50000000           # ceiling market cap (still room to run)
MARKET_MIN_LIQ_MC=0.03               # liquidity must be >= 3% of mcap (honeypot/exit sanity)
MARKET_MAX_DD_24H=-60                # skip if already down >60% in 24h (dying)
# EARLY-RUNNER focus: catch them BEFORE the move, not after. A token already up more than
# this in 24h has ALREADY RUN → it goes to the study pile (runners_to_study.txt), not the
# watch list. Lower this to be even earlier (e.g. 50); raise it to be more permissive.
MARKET_MAX_PUMP_24H=100              # >this 24h gain = already ran → study, don't watch
# SAFE MODE: POST-BONDED 10x — freshly GRADUATED pump.fun tokens (past the bonding curve, so
# the worst rugs are filtered) but still EARLY on the DEX where the 10x lives. LOW liquidity
# floor ($12k — graduation seeds only modest LP; graduation IS the safety filter), mcap capped
# (~$3M) so a 10x is still on the table. Scans fresh listings + rising volume. The market-watch
# TRADING sleeve. Tune with MARKET_SAFE_MIN_LIQ_USD / _MIN_HOLDERS / _MAX_MC_USD / _MAX_PUMP_24H.
MARKET_SAFE_MODE=false
MARKET_HISTORY_HOURS=6              # how long to keep per-token snapshots (for holder/volume growth)
MARKET_ALERT_SCORE=70                # Telegram-alert threshold (0..100 watch score)
MARKET_SCAN_LIMIT=50                 # tokens per list call (some plans cap at 50; >that can 400)
# COMPUTE-UNIT (CU) BUDGET. Every Birdeye call costs CU and the free monthly quota runs out
# fast — these defaults are FRUGAL. On a paid plan, widen MARKET_SORTS/PAGES/ENRICH for more.
MARKET_ENRICH_TOP=0                  # per-token holder lookups (0 = rely on the list; saves CU)
MARKET_RATE_DELAY=1.2                # min seconds between Birdeye calls (free tier ~1 rps)
MARKET_INTERVAL_SECS=600             # scan cadence — longer = less CU burn
MARKET_CU_COOLDOWN_SECS=3600         # back off this long when the CU quota is hit (don't hammer)
MARKET_ALERT_COOLDOWN_SECS=3600      # per-token re-alert gap
MARKET_PAGES=1                       # pages per sort — raise only on a paid plan
# Frugal but EARLY-oriented: volume RISERS + fresh listings (where early runners actually
# show up). Top absolute volume just surfaces already-pumped tokens, so it's NOT the default.
# Full coverage (paid plan): add volume_24h_usd,price_change_24h_percent,liquidity
MARKET_SORTS=volume_24h_change_percent,recent_listing_time

# ---- Learned avoidance: stop repeating mistakes (creator + pattern) ----
# The bot attributes each closed position's PnL to its creator and feature pattern,
# then avoids creators/patterns that keep losing. Decaying memory (recent dominates),
# persisted across runs. This is the "keep thinking, don't repeat mistakes" loop.
MOMENTUM_CREATOR_AVOID=true           # skip a creator whose tokens have lost the bot money before
MOMENTUM_CREATOR_MIN_TRADES=2         # closed trades on a creator before its record is trusted
MOMENTUM_CREATOR_AVOID_PNL=-0.02      # blacklist a creator at/below this decaying realized PnL/token (SOL)
MOMENTUM_PATTERN_AVOID=true           # penalize entries whose feature pattern has been losing
MOMENTUM_PATTERN_MIN_SAMPLES=20       # closed samples in a pattern band before it can penalize
MOMENTUM_PATTERN_PENALTY_MAX=25       # max entry-score penalty for a losing pattern
MOMENTUM_AVOIDANCE_FILE=momentum_avoidance.csv  # persisted creator+pattern memory
MOMENTUM_MAX_HOLD_SECS=10800         # force-close any position older than this (3h) — kills zombie/recovered-dead positions (0=off)
MOMENTUM_STALE_EXIT_SECS=180         # force-close a position whose token has not traded in this many secs (dead token); 0=off
MOMENTUM_EXIT_POLL_MS=1000           # how often every open position is re-checked (ms) = worst-case dump-reaction lag.
                                     #   Was effectively 3000; 1000 reacts 3x faster. Floor 200. Lower = faster escape.
MOMENTUM_KOL_AUTOMUTE=true           # auto-stop boosting a KOL once its tracked PnL goes net-negative
MOMENTUM_KOL_AUTOMUTE_MIN=4          # closed trades before a KOL can be auto-muted
MOMENTUM_MAX_MCAP_FRACTION=0.02      # cap position at this fraction of token mcap (never be the exit liquidity)
MOMENTUM_MAX_LIQ_FRACTION=0.10       # cap position at this fraction of bonding-curve liquidity
MOMENTUM_MIN_POSITION_SOL=0.01       # skip a token if liquidity caps the size below this (too illiquid)

